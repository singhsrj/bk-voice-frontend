# Copy this file to .env.local and fill it in.

# LiveKit Cloud project settings (Settings > Keys).
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Clerk: dashboard.clerk.com > your app > API keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Upstash Redis: console.upstash.com > create a database > REST API.
# Required for the daily limits to work when deployed (Netlify, Vercel, ...).
# Without them, an in-memory fallback is used, which only works for local dev.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Daily limits (optional). All reset at 00:00 UTC.
# Signed-in users:
SESSIONS_PER_USER_PER_DAY=5
# Guests (no sign-in). A guest cookie is easy to clear, so the per-IP and
# all-guests caps are what really protect your credits.
GUEST_SESSIONS_PER_DAY=2
GUEST_SESSIONS_PER_IP_PER_DAY=5
GUEST_SESSIONS_PER_DAY_ALL_GUESTS=20
# Everyone together (guests + signed-in):
SESSIONS_PER_DAY_ALL_USERS=50

# Set to false to turn guest ordering off and require sign-in.
GUESTS_ENABLED=true

# Your own Clerk user id(s), comma separated (Clerk dashboard > Users),
# so the limits don't get in your way while testing.
RATE_LIMIT_EXEMPT_USER_IDS=

# Only needed if you add agent_name="my-agent" back in agent.py.
# AGENT_NAME=my-agent

# Currency symbol shown on the receipt.
NEXT_PUBLIC_CURRENCY=₹
