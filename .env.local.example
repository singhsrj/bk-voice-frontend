# Copy this file to .env.local and fill it in.
# Find these in your LiveKit Cloud project settings (Settings > Keys).
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Only needed if you add agent_name="my-agent" back in agent.py.
# Leave it commented out while the agent uses automatic dispatch.
# AGENT_NAME=my-agent

# Currency symbol shown on the receipt.
NEXT_PUBLIC_CURRENCY=₹
